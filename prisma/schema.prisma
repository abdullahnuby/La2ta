// LA2TA | لقطة — Prisma Schema (MVP)
// Generic architecture: Store 1→N Offers, Category 1→N Offers
// SQLite => statuses/types stored as strings (no enums in SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  phone       String   @default("")
  whatsapp    String   @default("")
  address     String   @default("")
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  offers      Offer[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  icon      String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offers    Offer[]
}

model Offer {
  id                 Int       @id @default(autoincrement())
  storeId            Int
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId         Int?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title              String
  description        String    @default("")
  imageUrl           String    @default("")
  oldPrice           Float?
  newPrice           Float?
  discountPercentage Int?
  // discount | special | bundle | bogo | clearance | service
  offerType          String    @default("discount")
  startAt            DateTime
  endAt              DateTime
  isFeatured         Boolean   @default(false)
  // ACTIVE | DRAFT | PAUSED | EXPIRED
  status             String    @default("ACTIVE")
  // lightweight built-in analytics
  impressions        Int       @default(0)
  views              Int       @default(0)
  mapClicks          Int       @default(0)
  callClicks         Int       @default(0)
  whatsappClicks     Int       @default(0)
  shares             Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, endAt])
  @@index([categoryId])
  @@index([storeId])
}
